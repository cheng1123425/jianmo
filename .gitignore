# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- FreeCAD 备份 / 临时 ----
*.FCBak
*.bak
*.FCStd

# ---- 消息流水线的运行时产物（每次 pipe.py 重新生成，不进库）----
_msg/
_drawing.json

# ---- 调试产物（由 trace / 消息线生成，每次运行不同，不进库）----
docs/trace_report.html
docs/message_line.html

# ---- 建模中间产物（可重新生成）----
# _bracket_data.json / _socket_data.json 是支架/球铰盖两个零件投影导出的特征数据，
# 体积小且是它们校核脚本的直接输入，故保留进库；主流程（垫片）已改为消息架构，
# 其投影走 _msg/ 与 _drawing.json，不再入库。

# ---- 系统文件 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 工作目录（agent 的工作记忆，不属于项目产出；且含跨项目偏好信息）----
.workbuddy/

# ---- 编辑器 ----
.vscode/
.idea/
